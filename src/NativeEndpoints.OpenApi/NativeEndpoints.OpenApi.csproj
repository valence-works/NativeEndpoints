<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Optional. The core package takes no PackageReference at all, so describing parameters and
    generating a document are deliberately separated: the core states the facts as plain metadata,
    and this package - which does depend on the OpenAPI libraries - turns them into a document.
    A consumer who never generates one pays for nothing.
  -->
  <PropertyGroup>
    <Description>OpenAPI integration for NativeEndpoints: documents the route, query, header, and claim parameters an endpoint binds.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <ProjectReference Include="../NativeEndpoints/NativeEndpoints.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
