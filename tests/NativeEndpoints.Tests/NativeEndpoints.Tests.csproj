<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/NativeEndpoints/NativeEndpoints.csproj" />
    <ProjectReference Include="../../src/NativeEndpoints.OpenApi/NativeEndpoints.OpenApi.csproj" />
    <ProjectReference Include="../../src/NativeEndpoints.Testing/NativeEndpoints.Testing.csproj" />

    <!--
      The generator runs over this project's own endpoint fixtures, so its output is under test.
      Its assembly is also referenced directly (ReferenceOutputAssembly defaults to true) so tests
      can drive it with a GeneratorDriver and assert its diagnostics: an unmappable fixture class
      cannot live in this assembly, because the reflective-scan tests map the whole assembly and
      would then throw at startup.
    -->
    <ProjectReference Include="../../src/NativeEndpoints.Generator/NativeEndpoints.Generator.csproj"
                      OutputItemType="Analyzer" />
  </ItemGroup>

</Project>
