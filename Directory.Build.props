<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    net10.0 only, deliberately. .NET 9 left support in May 2026 and .NET 8 LTS ends in November,
    so a new library targeting either would ship dead code. net11.0 joins as a second target
    when it releases.
  -->
  <PropertyGroup Label="Package">
    <Authors>Valence Works</Authors>
    <Company>Valence Works</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/valence-works/NativeEndpoints</PackageProjectUrl>
    <RepositoryUrl>https://github.com/valence-works/NativeEndpoints</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    The package icon, shared by every packable project. Sourced from the branding folder and packed
    as icon.png to match PackageIcon above. Non-packable projects ignore it, so this can live here
    rather than being repeated per project.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)branding/native-endpoints-logo.png"
          Pack="true"
          PackagePath="icon.png"
          Visible="false" />
  </ItemGroup>

</Project>
